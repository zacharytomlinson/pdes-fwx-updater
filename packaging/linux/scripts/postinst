#!/bin/sh
set -e

INSTALL_ROOT="/opt/pdes-fwx-updater"
TOOLS_DIR="$INSTALL_ROOT/tools"
BOSSAC_PATH="$TOOLS_DIR/bossac"

# Reload udev rules shipped with the package
if command -v udevadm >/dev/null 2>&1; then
    udevadm control --reload-rules || true
    udevadm trigger || true
fi

mkdir -p "$TOOLS_DIR"

if [ ! -x "$BOSSAC_PATH" ]; then
    LEGACY_BOSSAC="/opt/pdes-win-fw-updater/tools/bossac"
    if [ -x "$LEGACY_BOSSAC" ]; then
        echo "NOTE: bossac found at legacy path $LEGACY_BOSSAC" >&2
        exit 0
    fi
    echo "ERROR: bossac not found at $BOSSAC_PATH (packaging error)." >&2
    exit 1
fi

exit 0
